{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stoic-iris.local/schemas/coordination/review.schema.json",
  "title": "IRIS Independent Agent Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "task_id",
    "reviewer",
    "producer",
    "created_at",
    "reviewed_revisions",
    "scope",
    "commands",
    "findings",
    "verdict",
    "independent",
    "material_disagreement",
    "protected_actions_authorized"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "review_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "task_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "reviewer": { "type": "string", "minLength": 1, "maxLength": 120 },
    "producer": { "type": "string", "minLength": 1, "maxLength": 120 },
    "created_at": { "type": "string", "format": "date-time" },
    "reviewed_revisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/revision" }
    },
    "scope": { "$ref": "#/$defs/string_list" },
    "commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/executed_command" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "verdict": { "enum": ["pass", "needs_changes", "blocked"] },
    "independent": { "const": true },
    "material_disagreement": { "type": "boolean" },
    "protected_actions_authorized": { "const": false }
  },
  "$defs": {
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "commit"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "branch": { "type": "string", "minLength": 1, "maxLength": 255 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "executed_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "command", "exit_code"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "command": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "severity",
        "repository",
        "path",
        "line",
        "summary",
        "evidence",
        "recommendation"
      ],
      "properties": {
        "finding_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
        "severity": { "enum": ["critical", "high", "medium", "low", "informational"] },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "path": { "type": "string", "minLength": 1, "maxLength": 500 },
        "line": { "type": "integer", "minimum": 1 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "recommendation": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "string_list": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
    }
  }
}
