{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stoic-iris.local/schemas/coordination/handoff.schema.json",
  "title": "IRIS Multi-Agent Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "task_id",
    "producer",
    "recipient",
    "created_at",
    "base_revisions",
    "result_revisions",
    "changed_paths",
    "commands",
    "evidence",
    "limitations",
    "rollback",
    "protected_actions_remaining",
    "ready_for_review"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "handoff_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "task_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "producer": { "type": "string", "minLength": 1, "maxLength": 120 },
    "recipient": { "type": "string", "minLength": 1, "maxLength": 120 },
    "created_at": { "type": "string", "format": "date-time" },
    "base_revisions": { "$ref": "#/$defs/revision_list" },
    "result_revisions": { "$ref": "#/$defs/result_list" },
    "changed_paths": { "$ref": "#/$defs/string_list" },
    "commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/executed_command" }
    },
    "evidence": { "$ref": "#/$defs/string_list" },
    "limitations": { "$ref": "#/$defs/string_list" },
    "rollback": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "protected_actions_remaining": { "$ref": "#/$defs/string_list" },
    "ready_for_review": { "type": "boolean" }
  },
  "$defs": {
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "commit"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "branch": { "type": "string", "minLength": 1, "maxLength": 255 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "revision_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/revision" }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "commit", "patch_digest"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "branch": { "type": "string", "minLength": 1, "maxLength": 255 },
        "commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "patch_digest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "anyOf": [
        { "required": ["commit"], "properties": { "commit": { "type": "string" } } },
        { "required": ["patch_digest"], "properties": { "patch_digest": { "type": "string" } } }
      ]
    },
    "result_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/result" }
    },
    "executed_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "command", "exit_code"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "command": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    },
    "string_list": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
    }
  }
}
