{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "permissions": {
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Edit",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current)",
      "Bash(git worktree add *)",
      "Bash(git worktree list *)",
      "Bash(git worktree prune)",
      "Bash(pnpm install --offline --frozen-lockfile --ignore-scripts)",
      "Bash(pnpm format:check)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm build)",
      "Bash(pnpm diagnostics)",
      "Bash(pnpm verify)",
      "Bash(gh auth status)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr review *)",
      "Bash(gh pr merge *)"
    ],
    "ask": [
      "Bash(git worktree remove *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git restore *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm update *)",
      "Bash(npm install*)",
      "Bash(npx *)",
      "Bash(docker *)",
      "Bash(kubectl *)",
      "Bash(terraform *)",
      "Bash(aws *)",
      "Bash(gcloud *)",
      "Bash(az *)",
      "Bash(vercel *)",
      "Bash(wrangler *)",
      "Bash(ssh *)",
      "PowerShell(git worktree remove *)",
      "PowerShell(git switch *)",
      "PowerShell(git checkout *)",
      "PowerShell(git restore *)",
      "PowerShell(git rm *)",
      "PowerShell(git mv *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git merge *)",
      "PowerShell(git push *)",
      "PowerShell(git rebase *)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Bash(gh auth token)",
      "Bash(gh auth token *)",
      "Bash(git push *--force*)",
      "Bash(git push * -f *)",
      "Bash(git push +*)",
      "Bash(git push * +*)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(git worktree remove *--force*)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git commit *--amend*)",
      "Bash(git add .)",
      "Bash(git add ./)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add -u*)",
      "Bash(git add :/*)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh api *)",
      "Bash(gh release *)",
      "Bash(gh pr merge *--admin*)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh ruleset *)",
      "PowerShell(gh auth token)",
      "PowerShell(gh auth token *)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push * -f *)",
      "PowerShell(git push +*)",
      "PowerShell(git push * +*)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean -f*)",
      "PowerShell(git worktree remove *--force*)",
      "PowerShell(git branch -d *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git filter-branch *)",
      "PowerShell(git filter-repo *)",
      "PowerShell(git commit *--amend*)",
      "PowerShell(git add .)",
      "PowerShell(git add ./)",
      "PowerShell(git add -A*)",
      "PowerShell(git add --all*)",
      "PowerShell(git add -u*)",
      "PowerShell(git add :/*)",
      "PowerShell(gh repo delete *)",
      "PowerShell(gh repo edit *)",
      "PowerShell(gh api *)",
      "PowerShell(gh release *)",
      "PowerShell(gh pr merge *--admin*)",
      "PowerShell(gh secret *)",
      "PowerShell(gh variable *)",
      "PowerShell(gh ruleset *)"
    ]
  }
}
